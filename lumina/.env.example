# Copy to .env and edit. Never commit .env.

# --- Server -------------------------------------------------------------
# Ports are deliberately unusual so this project does not clash with others on localhost.
PORT=4317
NODE_ENV=development
# Public URL of the site (used for cookie "Secure" decision and CORS-free same-origin setup)
PUBLIC_URL=http://localhost:4317

# --- Database -----------------------------------------------------------
# Development default: a local SQLite file (Node built-in driver, no install needed).
DATABASE_URL=sqlite:./data/lumina.db
# Production: PostgreSQL (requires `npm install pg`)
# DATABASE_URL=postgres://user:password@host:5432/lumina

# --- First admin (created by `npm run seed`) ------------------------------
ADMIN_EMAIL=admin@lumina.local
ADMIN_PASSWORD=ChangeMe!2026

# --- Google sign-in (optional) --------------------------------------------
# Create an OAuth 2.0 Web client at https://console.cloud.google.com/apis/credentials
# and add http://localhost:4317 to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# --- AI assistant (optional) ----------------------------------------------
# Without a key the assistant falls back to a built-in lesson-grounded helper.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Analytics ------------------------------------------------------------
# A learner counts as "dropped out" when an unfinished enrolment has had no activity for this many days.
DROPOUT_DAYS=14
